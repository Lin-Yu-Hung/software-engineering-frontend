# Optional local development settings. Compose also works without a .env file.
DB_NAME=booking
DB_USER=booking
DB_PASSWORD=booking_dev_password
DB_PORT=5433
API_PORT=8080
TEST_DB_PORT=5434
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
JWT_SECRET=booking-local-development-key-change-before-deployment
SECURE_COOKIE=false
DEMO_USERS_ENABLED=true
# Only local coursework demo; no real charge. Application default is false.
DEMO_PAYMENTS_ENABLED=true
HOLD_SECONDS=600

# 綠界付款結果通知網址：填入你自己的 ngrok https 網址 + /api/v1/payments/ecpay/notify（留空則停用綠界付款）
# 範例：ECPAY_RETURN_URL=https://你的網域.ngrok-free.dev/api/v1/payments/ecpay/notify
ECPAY_RETURN_URL=

# Azure 雲端版（參考用；Azure 讀的是 App Service 環境變數，不讀此檔，且需先部署含綠界程式的新版後端）
# ECPAY_RETURN_URL=https://ccu-booking-api-1fd823.azurewebsites.net/api/v1/payments/ecpay/notify
# ECPAY_ORDER_RESULT_URL=https://ccu-booking-api-1fd823.azurewebsites.net/api/v1/payments/ecpay/result
# ECPAY_FRONTEND_RESULT_URL=http://localhost:5173/my-bookings
