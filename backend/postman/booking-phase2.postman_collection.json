{
  "info": {
    "_postman_id": "342d1165-2b57-40d7-9bd0-35fd1e2d0478",
    "name": "Booking Backend - Phase 2",
    "description": "Run the full collection in order with Booking Local selected. Uses automatic cookie jar and stores JWT in collection variables. Creates a unique demo member and a demo court; the court is retired at the end. Expected 400/401/403/409 responses are tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "memberEmail",
      "value": ""
    },
    {
      "key": "memberPassword",
      "value": "MemberDemo123!"
    },
    {
      "key": "managedCourtId",
      "value": ""
    },
    {
      "key": "courtVersion",
      "value": "0"
    },
    {
      "key": "managedCourtName",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Database migration V4",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Schema ready\", () => pm.expect(Number(pm.response.json().schemaVersion)).to.be.at.least(4));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 - Register unique member",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/register",
        "auth": {
          "type": "noauth"
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"{{memberPassword}}\",\n  \"name\": \"Postman 測試會員\",\n  \"phone\": \"0912345678\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set(\"memberEmail\", \"postman-\" + Date.now() + \"-\" + Math.floor(Math.random()*100000) + \"@example.test\");",
              "pm.collectionVariables.set(\"managedCourtName\", \"Postman 測試場 \" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "pm.test(\"Member role only\", () => pm.expect(pm.response.json().roles).to.eql([\"MEMBER\"]));",
              "pm.test(\"No password in response\", () => pm.expect(pm.response.json()).not.to.have.property(\"passwordHash\"));"
            ]
          }
        }
      ],
      "response": []
    },
