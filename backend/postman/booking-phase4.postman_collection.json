          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/backoffice/courts",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Phase4 demo {{suffix}}\",\n  \"type\": \"標準 PU\",\n  \"status\": \"ACTIVE\",\n  \"displayOrder\": 90\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\",()=>pm.response.to.have.status(201));",
              "pm.collectionVariables.set(\"courtId\",pm.response.json().id);pm.collectionVariables.set(\"courtVersion\",pm.response.json().version);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "05 - Select two available slots",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/availability?date={{queryDate}}&courtId={{courtId}}",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const slots=pm.response.json().slots.filter(slot=>slot.status===\"AVAILABLE\").slice(0,2);",
              "pm.test(\"Two demo slots exist\",()=>pm.expect(slots).to.have.lengthOf(2));",
              "pm.collectionVariables.set(\"holdBody\",JSON.stringify({items:slots.map(slot=>({courtId:slot.courtId,startAt:slot.startAt}))}));"
            ]
          }
        }
      ],
      "response": []
    },
