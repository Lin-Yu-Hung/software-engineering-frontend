  "item": [
    {
      "name": "01 - Database V6",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "pm.test(\"Schema V6\",()=>pm.expect(Number(pm.response.json().schemaVersion)).to.be.at.least(6));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 - Tomorrow in Taipei",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/venue",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
              "const tomorrow=new Date(pm.response.json().earliestDate+\"T00:00:00Z\");tomorrow.setUTCDate(tomorrow.getUTCDate()+1);pm.collectionVariables.set(\"queryDate\",tomorrow.toISOString().slice(0,10));",
              "pm.collectionVariables.set(\"suffix\",String(Date.now()));",
              "pm.collectionVariables.set(\"holdKey\",\"phase4-hold-\"+Date.now());pm.collectionVariables.set(\"orderKey\",\"phase4-order-\"+Date.now());",
              "pm.test(\"Booking enabled\",()=>pm.expect(pm.response.json().bookingEnabled).to.eql(true));"
            ]
          }
        }
      ],
      "response": []
    },
    {
