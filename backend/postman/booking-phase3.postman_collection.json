    {
      "name": "06 - Choose future date without exception",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/v1/backoffice/calendar-exceptions?from={{today}}&to={{lastDate}}"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "const used = new Set(pm.response.json().map(entry => entry.date));",
              "const candidate = new Date(pm.collectionVariables.get(\"today\") + \"T00:00:00Z\");",
              "const last = pm.collectionVariables.get(\"lastDate\"); let chosen = \"\";",
              "for (let day = 0; day < 365; day++) { candidate.setUTCDate(candidate.getUTCDate() + 1); const date = candidate.toISOString().slice(0,10); if (date > last) break; if (!used.has(date)) { chosen = date; break; } }",
              "pm.test(\"Unused future test date exists\", () => pm.expect(chosen).not.to.eql(\"\"));",
              "if (!chosen) throw new Error(\"No unused future date; use a separate development database.\");",
              "pm.collectionVariables.set(\"queryDate\", chosen);",
              "const dayOfWeek = candidate.getUTCDay() || 7;",
              "pm.collectionVariables.set(\"dayOfWeek\", dayOfWeek);",
              "pm.collectionVariables.set(\"dayType\", dayOfWeek >= 6 ? \"WEEKEND\" : \"WEEKDAY\");"
            ]
          }
        }
      ],
      "response": []
    },
