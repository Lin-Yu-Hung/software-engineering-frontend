# Optional local development settings. Compose also works without a .env file.
DB_NAME=booking
DB_USER=booking
DB_PASSWORD=booking_dev_password
DB_PORT=5433
API_PORT=8080
TEST_DB_PORT=5434
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174
JWT_SECRET=booking-local-development-key-change-before-deployment
SECURE_COOKIE=false
DEMO_USERS_ENABLED=true
# Only local coursework demo; no real charge. Application default is false.
DEMO_PAYMENTS_ENABLED=true
HOLD_SECONDS=600
