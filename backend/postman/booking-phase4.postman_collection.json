{
  "info": {
    "_postman_id": "71c3ec12-9d0c-43bc-b20a-199f57317cf9",
    "name": "Booking Backend - Phase 4",
    "description": "Run in order. Creates its own test court and members. Verifies hold, order, ownership, conflict, cancellation and cleanup. Leaves cancelled order history and retired court.",
